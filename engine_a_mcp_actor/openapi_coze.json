{
  "openapi": "3.1.0",
  "info": {
    "title": "AI大模型实时比价路由与Token预算计算器 (AI LLM Price Router)",
    "description": "实时汇总全球 OpenRouter 与国内主流云厂商（阿里云百炼 Qwen、腾讯云 DeepSeek/混元、硅基流动 SiliconFlow、火山引擎豆包）80+ 款大模型的最新输入/输出价格（RMB 人民币 & USD 美元双币种），提供最省钱模型智能推荐、月度/年度 API 预算测算及免费模型查询。可直接一键导入扣子 (Coze.cn) 插件商店开启付费调用变现（支付宝提现）。",
    "version": "1.0.0",
    "contact": {
      "name": "AI Revenue Engine — Engine A"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://your-public-endpoint.example.com",
      "description": "部署后的公网 HTTPS 地址（例如阿里云函数计算 / 腾讯云 SCF / Railway / Cloudflare Tunnel 映射 mcp_server.py --http 8787）"
    },
    {
      "url": "http://127.0.0.1:8787",
      "description": "本地调试地址 (python3 mcp_server.py --http 8787)"
    }
  ],
  "paths": {
    "/api/recommend": {
      "post": {
        "operationId": "recommend_cheapest_model",
        "summary": "根据任务类型、上下文长度与地区偏好推荐最便宜高性价比的AI大模型",
        "description": "输入任务场景（写代码 coding、深度推理 reasoning、通用对话 general、多模态 multimodal、免费 free）以及每月预计输入/输出百万 Token 数量，自动对比 80+ 款国内外模型并返回最省钱付费首选、综合性价比首选、免费备选及直达开通链接。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_type": {
                    "type": "string",
                    "description": "任务类型：coding(代码开发)、reasoning(逻辑数学推理)、general(通用文本)、multimodal(图文多模态)、cheap(超低价)、free(完全免费)",
                    "enum": ["coding", "reasoning", "general", "multimodal", "cheap", "free"],
                    "default": "coding"
                  },
                  "min_context": {
                    "type": "integer",
                    "description": "要求的最小上下文窗口 Token 数，例如 32000、128000、1000000",
                    "default": 32000
                  },
                  "region_preference": {
                    "type": "string",
                    "description": "API通道地区偏好：cn_direct(仅国内直连低延迟人民币通道)、global(全球OpenRouter美元通道)、any(国内外全部对比)",
                    "enum": ["cn_direct", "global", "any"],
                    "default": "any"
                  },
                  "monthly_input_m": {
                    "type": "number",
                    "description": "预计每月输入 Prompt Token 数量（单位：百万 Tokens，例如 10 代表 1000 万输入 Tokens）",
                    "default": 10.0
                  },
                  "monthly_output_m": {
                    "type": "number",
                    "description": "预计每月输出 Completion Token 数量（单位：百万 Tokens，例如 2 代表 200 万输出 Tokens）",
                    "default": 2.0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回最优模型路由推荐与月度双币种成本估算",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "object" },
                    "updated_at": { "type": "string" },
                    "fx_rate_usd_to_rmb": { "type": "number" },
                    "total_candidates_matched": { "type": "integer" },
                    "cheapest_paid_pick": { "type": ["object", "null"] },
                    "best_value_pick": { "type": ["object", "null"] },
                    "best_free_pick": { "type": ["object", "null"] },
                    "recommendations": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/budget": {
      "post": {
        "operationId": "calculate_api_budget",
        "summary": "计算指定AI大模型的每日/每月/每年API账单预算并寻找降本平替模型",
        "description": "根据模型名称（如 deepseek-v3、qwen3、claude、gpt、doubao 等）、每日请求量及单次平均输入输出 Token 数，精准核算人民币 (RMB) 与美元 (USD) 成本，并自动推荐最高可省 80%+ 的同级别平替模型。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model_query"],
                "properties": {
                  "model_query": {
                    "type": "string",
                    "description": "目标模型名称或关键字，例如 deepseek-v3、qwen3、claude-sonnet、gpt-5、doubao（当 usage_snippet 传入多模型 CSV 账单时可传 auto 自动识别头号开销模型）",
                    "default": "deepseek-v3"
                  },
                  "daily_requests": {
                    "type": "integer",
                    "description": "预计每天 API 调用请求次数",
                    "default": 1000
                  },
                  "avg_input_tokens": {
                    "type": "integer",
                    "description": "每次请求平均输入 Prompt Token 数",
                    "default": 1500
                  },
                  "avg_output_tokens": {
                    "type": "integer",
                    "description": "每次请求平均输出 Completion Token 数",
                    "default": 500
                  },
                  "cache_hit_rate": {
                    "type": "number",
                    "description": "Prompt 缓存命中率（0.0 到 1.0，默认 0.0；例如 0.5 表示 50% 输入命中缓存折扣价）",
                    "default": 0.0
                  },
                  "reasoning_multiplier": {
                    "type": "number",
                    "description": "深度思考模型输出倍率（默认 1.0；未包含隐式思维链时可设为 2.5）",
                    "default": 1.0
                  },
                  "output_includes_reasoning": {
                    "type": "boolean",
                    "description": "若 avg_output_tokens 已包含思考 Token 则设为 true，避免重复乘倍率",
                    "default": false
                  },
                  "usage_mode": {
                    "type": "string",
                    "description": "使用场景：interactive_ide（交互式编程工具）或 automated_backend（自动化后端自动排除个人编程套餐）",
                    "enum": ["interactive_ide", "automated_backend"],
                    "default": "interactive_ide"
                  },
                  "peak_5h_calls": {
                    "type": "integer",
                    "description": "可选：最繁忙连续 5 小时峰值请求次数，用于核验 Pro 6,000 次 / Lite 1,200 次滚动窗口"
                  },
                  "team_size": {
                    "type": "integer",
                    "description": "可选：交互式编程团队人数（1～50，默认 1），对比 N 席独立 Coding Plan 订阅与共享按量池",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 1
                  },
                  "monthly_requests": {
                    "type": "integer",
                    "description": "可选：月度总调用请求次数（来自云控制台账单，传入后自动换算日均请求）",
                    "minimum": 1
                  },
                  "monthly_input_m": {
                    "type": "number",
                    "description": "可选：月度总输入 Token 数（百万 Token）",
                    "minimum": 0
                  },
                  "monthly_output_m": {
                    "type": "number",
                    "description": "可选：月度总输出 Token 数（百万 Token）",
                    "minimum": 0
                  },
                  "cached_input_m": {
                    "type": "number",
                    "description": "可选：月度命中缓存输入 Token 数（百万 Token），自动核算精确 cache_hit_rate",
                    "minimum": 0
                  },
                  "usage_snippet": {
                    "type": "string",
                    "description": "可选：粘贴 OpenRouter Activity 多模型 CSV/TSV/JSON/JSONL 账单（含 Claude Code .jsonl 会话与 OpenAI Batch .jsonl）、Claude Code /cost 输出、usage JSON 或统计摘要，自动解析并返回 bill_audit 与零改代码 LiteLLM 迁移配置 (migration_litellm_config)"
                  },
                  "usage_snippets": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "可选：传入多个 Claude Code .jsonl 会话文件与 CSV 账单文本列表，自动跨文件按 message.id 去重合并为统一 30 天多模型审计报表"
                  },
                  "usage_file_names": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "可选：与 usage_snippets 对齐的文件名或会话标签列表，用于生成按文件消耗排行 file_breakdown（自动过滤本地用户名路径）"
                  },
                  "days_observed": {
                    "type": "number",
                    "description": "可选：usage_snippet 对应的统计天数（默认 30 天，如近 7 天日志可传 7）",
                    "default": 30
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回日/月/年双币种账单预算、Coding Plan 多席位与超额混合计费核验及更低价平替模型列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "object" },
                    "matched_model": { "type": "object" },
                    "token_volume": { "type": "object" },
                    "budget_estimate": {
                      "type": "object",
                      "properties": {
                        "daily_usd": { "type": "number" },
                        "monthly_usd": { "type": "number" },
                        "yearly_usd": { "type": "number" },
                        "daily_rmb": { "type": "number" },
                        "monthly_rmb": { "type": "number" },
                        "yearly_rmb": { "type": "number" }
                      }
                    },
                    "coding_plan_evaluation": { "type": "object" },
                    "self_host_evaluation": { "type": "object" },
                    "client_endpoints": { "type": "object" },
                    "cheaper_alternatives": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/free-cheap": {
      "post": {
        "operationId": "list_free_and_ultra_cheap_models",
        "summary": "列出当前可用的免费($0/¥0)与白菜价超低成本AI大模型API清单",
        "description": "一键获取国内外完全免费的 API 模型（¥0 / $0）以及百万 Token 综合成本低于 ¥3.60 ($0.50) 的高性价比主力模型。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "string",
                    "description": "地区筛选：cn_direct(国内直连通道)、global(全球OpenRouter通道)、any(全部)",
                    "enum": ["cn_direct", "global", "any"],
                    "default": "any"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回免费模型与超低价模型列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "region_filter": { "type": "string" },
                    "updated_at": { "type": "string" },
                    "total_free_models": { "type": "integer" },
                    "total_ultra_cheap_paid_models": { "type": "integer" },
                    "free_models": {
                      "type": "array",
                      "items": { "type": "object" }
                    },
                    "ultra_cheap_paid_models": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health_check",
        "summary": "检查AI比价路由API服务状态与实时模型库更新时间",
        "description": "返回当前在线模型总数、汇率基准、最后更新时间以及 x402 支付状态。",
        "responses": {
          "200": {
            "description": "服务正常运行",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "service": { "type": "string" },
                    "total_models": { "type": "integer" },
                    "updated_at": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
